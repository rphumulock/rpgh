package pages

import (
	"rpgh/features/common/components"
	"rpgh/features/common/layouts"
	portfolio "rpgh/features/portfolio/components"
	"rpgh/web/resources"
)

type PortfolioSignals struct {
	Filter   string `json:"filter"`
	Playlist string `json:"playlist"`
	// Playing is the watch id of the episode being watched, empty until a
	// card is clicked. One signal for the page, so starting one card stops
	// any other.
	Playing string `json:"playing"`
}

// aboutLine and strengthsLine are the two lines under `$ whoami`. Placeholder
// copy for now -- swap in the real bio whenever.
const (
	aboutLine     = "Software engineer who likes small, fast, boring-in-a-good-way web apps -- mostly Go on the backend and hypermedia on the wire."
	strengthsLine = "real-time systems · event-driven backends · server-rendered UIs · developer tooling"
)

templ PortfolioAbout() {
	<section class="bg-base-100 py-8 px-4 shrink-0">
		<div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center sm:items-start gap-6">
			<img
				src={ resources.StaticPath("assets/avatar.webp") }
				alt="Portrait of rpgh"
				width="160"
				height="160"
				class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-full object-cover border-2 border-primary"
			/>
			<div class="flex flex-col gap-2">
				<h1 class="text-2xl font-bold">
					<span class="text-secondary">$ </span>whoami
					@components.Cursor()
				</h1>
				<p class="text-lg opacity-60" id="about">{ aboutLine }</p>
				<p class="text-sm opacity-40" id="strengths">{ strengthsLine }</p>
			</div>
		</div>
	</section>
}

// Filter buttons drive the `filter` signal; cards hide themselves via data-show.
templ PortfolioProjects() {
	<section class="bg-base-200 py-6 px-4 lg:flex-1 lg:min-h-0 lg:overflow-y-auto">
		<div class="max-w-5xl mx-auto flex flex-col gap-4">
			<h2 class="text-xl font-bold flex items-baseline flex-wrap gap-x-1">
				<span><span class="text-secondary">$ </span>ls ./projects --filter=</span>
				<span class="text-primary" data-show={ "$filter === '" + portfolio.FilterAll + "'" }>all</span>
				<button
					type="button"
					title="Clear the filter"
					class="text-primary inline-flex items-baseline gap-1 border-b border-dotted border-primary hover:opacity-60 transition-opacity"
					data-show={ "$filter !== '" + portfolio.FilterAll + "'" }
					data-on:click={ portfolio.SetFilterExpr(portfolio.FilterAll) }
				>
					<span data-text="$filter"></span>
					<span class="text-xs opacity-70" aria-hidden="true">&#10005;</span>
				</button>
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="projects">
				for _, p := range portfolio.Projects {
					@portfolio.ProjectCard(p)
				}
			</div>
		</div>
	</section>
}

// openOn is the state the page opens in. Which directory a visitor is standing
// in is the route now, not a signal, so what is left here is the state inside
// one panel -- and the filter starts wherever the link that brought them here
// asked for, which is how a tech chip lands someone on the projects it named.
func openOn(filter string) PortfolioSignals {
	return PortfolioSignals{
		Filter:   portfolio.FilterOrAll(filter),
		Playlist: portfolio.DefaultPlaylist(),
		Playing:  "",
	}
}

// Panel is the one directory this request is standing in. Every page here
// wears the same chrome and the same `whoami`, so what a route decides is only
// what goes under it -- and a key nothing matches falls through to the
// listing, which is the page a visitor can get anywhere from.
templ Panel(tab string) {
	switch tab {
		case portfolio.TabProjects:
			@portfolio.PanelPath(tab)
			@PortfolioProjects()
		case portfolio.TabStack:
			@portfolio.PanelPath(tab)
			@portfolio.StackSection()
		case portfolio.TabBlogs:
			@portfolio.PanelPath(tab)
			@portfolio.BlogsSection()
		case portfolio.TabVideos:
			@portfolio.PanelPath(tab)
			@portfolio.VideosSection()
		default:
			@portfolio.DirectorySection()
	}
}

// PortfolioPage is one directory of the site: the listing at the root, or the
// panel the route named. Each is its own document at its own URL, so cd-ing
// into one is a real navigation -- the back button leaves it, and the address
// is a link someone else can open on the same view.
templ PortfolioPage(tab, filter string) {
	@layouts.Base("rpgh") {
		<div
			data-theme="terminal"
			class="crt flex flex-col w-full flex-1 min-h-0 lg:overflow-hidden font-mono"
			data-signals={ templ.JSONString(openOn(filter)) }
		>
			@components.SiteHeader()
			<main class="flex flex-col flex-1 min-h-0">
				@PortfolioAbout()
				<div class="flex flex-col flex-1 min-h-0">
					@Panel(tab)
				</div>
			</main>
			@components.SiteFooter()
		</div>
	}
}
