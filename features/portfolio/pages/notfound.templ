package pages

import (
	"rpgh/features/common/components"
	"rpgh/features/common/layouts"
	portfolio "rpgh/features/portfolio/components"
)

// NotFound is what a path nothing serves gets. Every directory is a URL now,
// so a mistyped one is a page a visitor can actually land on -- from a typo,
// or from a link that named a directory before it was renamed. It answers the
// way the shell would, and then lists what is really there, because the useful
// half of "no such directory" is knowing which ones exist.
templ NotFound(path string) {
	@layouts.Base("not found -- rpgh") {
		<div data-theme="terminal" class="crt flex flex-col w-full flex-1 min-h-0 lg:overflow-hidden font-mono">
			@components.SiteHeader()
			<main class="flex flex-col flex-1 min-h-0">
				<section class="bg-base-100 py-8 px-4 shrink-0">
					<div class="max-w-5xl mx-auto flex flex-col gap-2">
						<h1 class="text-xl font-bold truncate">
							<span class="text-secondary">$ </span>{ "cd " + path }
							@components.Cursor()
						</h1>
						<p class="opacity-60 truncate">{ "cd: " + path + ": No such file or directory" }</p>
					</div>
				</section>
				<div class="flex flex-col flex-1 min-h-0">
					@portfolio.DirectorySection()
				</div>
			</main>
			@components.SiteFooter()
		</div>
	}
}
