package components

import (
	"fmt"
	common "rpgh/features/common/components"
)

// SetupPanel is the column beside the tree: the machine the work happens on,
// rather than what any one project was built with. Nothing here is clickable
// -- these are not filters, and dressing them up as buttons would imply a
// project behind each one.
templ SetupPanel() {
	<aside class="flex flex-col gap-4">
		<div class="flex flex-col gap-1">
			<h2 class="text-2xl font-bold">
				<span class="text-secondary">$ </span>cat ~/.setup
			</h2>
			<p class="text-xs opacity-40">{ SetupIntro }</p>
		</div>
		<ul class="flex flex-col gap-3 text-sm">
			for _, item := range Setup {
				<li class="flex gap-3 border-l border-base-300 pl-3">
					<span class="text-primary pt-0.5 shrink-0">
						@common.Icon(item.Icon, "width", "18", "height", "18")
					</span>
					<div class="flex flex-col gap-0.5 min-w-0">
						<span class="flex items-baseline gap-2 flex-wrap">
							<span class="font-bold">{ item.Name }</span>
							<span class="text-xs opacity-30">{ item.Role }</span>
						</span>
						<span class="text-xs opacity-50">{ item.Note }</span>
					</div>
				</li>
			}
		</ul>
	</aside>
}

// StackSection renders the toolbox as `tree` output: each category is a
// directory line, its items the leaves indented beneath it. Items a project
// was actually built with are clickable and jump back to the projects tab
// with that tech applied as the filter; the rest are inert labels.
templ StackSection() {
	<section class="bg-base-100 py-6 px-4 lg:flex-1 lg:min-h-0 lg:overflow-y-auto">
		<div class="max-w-5xl mx-auto grid gap-8 lg:grid-cols-3 items-start">
			@SetupPanel()
			<div class="flex flex-col gap-4 min-w-0 lg:col-span-2">
			<div class="flex flex-col gap-1">
				<h2 class="text-2xl font-bold">
					<span class="text-secondary">$ </span>tree ./stack
				</h2>
				<p class="text-xs opacity-40">
					Solid entries have a project behind them &mdash; click one to see it.
				</p>
			</div>
			<div class="flex flex-col gap-3 text-sm">
				for i, cat := range Stack {
					<div class="flex flex-col gap-2">
						<div class="flex items-baseline gap-2">
							<span class="opacity-40 select-none" aria-hidden="true">{ TreeGlyph(i) }</span>
							<span class="text-primary font-bold">{ cat.Name }/</span>
							<span class="opacity-30">{ fmt.Sprintf("(%d)", len(cat.Items)) }</span>
						</div>
						<div class="flex">
							<span class="opacity-40 select-none pr-3" aria-hidden="true">{ TreePipe(i) }</span>
							<ul class="flex flex-wrap gap-2">
								for _, item := range cat.Items {
									{{ used := TechUseCount(item.Name) }}
									<li>
										if used > 0 {
											<a
												href={ templ.SafeURL(ProjectsFilterHref(item.Name)) }
												title={ fmt.Sprintf("Show the %d project(s) built with %s", used, item.Name) }
												class="flex items-center gap-1.5 border border-base-300 px-2 py-1 hover:border-primary hover:text-primary transition-colors"
											>
												if item.Icon != "" {
													@common.Icon(item.Icon, "width", "16", "height", "16")
												}
												<span>{ item.Name }</span>
												<span class="text-primary opacity-70">{ fmt.Sprintf("(%d)", used) }</span>
											</a>
										} else {
											<span
												title="Nothing on the projects tab uses this yet"
												class="flex items-center gap-1.5 border border-base-300 border-dashed px-2 py-1 opacity-40"
											>
												if item.Icon != "" {
													@common.Icon(item.Icon, "width", "16", "height", "16")
												}
												<span>{ item.Name }</span>
											</span>
										}
									</li>
								}
							</ul>
						</div>
					</div>
				}
			</div>
			<p class="opacity-30 text-xs">
				{ fmt.Sprintf("%d directories, %d files", len(Stack), StackCount()) }
			</p>
			</div>
		</div>
	</section>
}
