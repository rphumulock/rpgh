package components

import common "rpgh/features/common/components"

// VideoCard is one video on the page: the featured episode of a playlist, or
// one of the one-offs on a series that has no playlist behind it. It is laid
// out wide rather than as a grid tile, since a container holds few of them.
//
// The still is a facade, not the player: the iframe carries no src attribute
// until $playing names this episode, so a visitor who never clicks never
// reaches YouTube. Only i.ytimg.com is contacted before that click, which is
// all the still needs and all router/middleware.go allowed before the
// frame-src that landed with this card.
//
// The two referrer policies here disagree on purpose. The still is served to
// anyone, so it goes out with no referrer. The player is not: YouTube reads
// the embedding origin off the Referer header and answers a request without
// one with a configuration error, so the iframe has to send at least an
// origin. strict-origin-when-cross-origin is what YouTube's own oEmbed markup
// uses and what the site already sends by header -- it is named here anyway,
// so the requirement is visible next to the thing that depends on it.
templ VideoCard(v Video) {
	<div class="group border border-base-300 flex flex-col sm:flex-row hover:border-primary transition-colors">
		<div class="relative shrink-0 sm:w-2/5 border-b sm:border-b-0 sm:border-r border-base-300">
			<button
				type="button"
				title={ "Play " + v.Label() }
				aria-label={ "Play " + v.Label() }
				class="block w-full cursor-pointer"
				data-show={ "!(" + v.PlayingExpr() + ")" }
				data-on:click={ v.PlayExpr() }
			>
				<img
					src={ v.ThumbURL() }
					alt={ v.Label() }
					width="320"
					height="180"
					loading="lazy"
					referrerpolicy="no-referrer"
					class="w-full aspect-video object-cover opacity-80 group-hover:opacity-100 transition-opacity"
				/>
				<span
					class="absolute inset-0 flex items-center justify-center text-primary opacity-70 group-hover:opacity-100 transition-opacity"
					aria-hidden="true"
				>
					@common.Icon("lucide:play", "width", "40", "height", "40")
				</span>
				if v.Episode != "" {
					<span class="absolute bottom-2 right-2 bg-base-100 border border-base-300 px-1.5 py-0.5 text-xs">
						{ "ep " + v.Episode }
					</span>
				}
			</button>
			<iframe
				title={ v.Label() }
				class="w-full aspect-video"
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
				allow="autoplay; encrypted-media; picture-in-picture"
				allowfullscreen
				data-show={ v.PlayingExpr() }
				data-attr:src={ v.EmbedSrcExpr() }
			></iframe>
		</div>
		<div class="p-4 flex flex-col gap-2">
			<h4 class="font-bold">
				<span class="text-secondary">$ </span>
				<a
					href={ templ.SafeURL(v.WatchURL()) }
					title={ "Watch " + v.Label() + " on YouTube" }
					class="hover:text-primary transition-colors"
				>
					{ v.Title }
				</a>
			</h4>
			<p class="text-sm opacity-60">{ v.Blurb }</p>
			<p class="text-xs opacity-30 mt-auto">{ v.Published }</p>
		</div>
	</div>
}

// PlaylistTabs is the switcher across the section: one tab per playlist,
// driving the $playlist signal the containers below watch.
templ PlaylistTabs() {
	<ul class="flex flex-wrap gap-1 border-b border-base-300" role="tablist">
		for _, p := range PlaylistPanels() {
			<li>
				<button
					type="button"
					role="tab"
					class="px-3 py-2 text-sm border-b-2 border-transparent -mb-px hover:text-primary transition-colors"
					data-class={ PlaylistActiveExpr(p.Key()) }
					data-attr:aria-selected={ PlaylistSelectedExpr(p.Key()) }
					data-on:click={ SetPlaylistExpr(p.Key()) }
				>
					{ p.Series.Name }
				</button>
			</li>
		}
	</ul>
}

// PlaylistContainer is the one container a series gets: which channel it is
// from and where to watch more, then whatever cards the series puts on the
// page. It shows only while its own tab is the selected one.
templ PlaylistContainer(p PlaylistPanel) {
	<article
		class="border border-base-300 bg-base-100 flex flex-col"
		role="tabpanel"
		data-show={ PlaylistSelectedExpr(p.Key()) }
	>
		<header class="border-b border-base-300 px-4 py-3 flex flex-wrap items-baseline justify-between gap-3">
			<div class="flex flex-col gap-1">
				<h3 class="text-lg font-bold flex flex-wrap items-baseline gap-x-2">
					<span><span class="text-secondary">$ </span>{ p.Series.Name }</span>
					<span class="opacity-30 text-sm">{ plural(len(p.Series.Videos), "video") }</span>
				</h3>
				<p class="text-sm opacity-60">{ p.Series.Blurb }</p>
				<a
					href={ templ.SafeURL(p.ChannelURL) }
					title={ "Open " + p.Handle + " on YouTube" }
					class="text-xs opacity-40 hover:opacity-100 hover:text-primary transition-opacity w-fit"
				>
					{ p.Handle }
				</a>
			</div>
			if p.Series.HasPlaylist() {
				<a
					href={ templ.SafeURL(p.Series.PlaylistURL()) }
					class="btn btn-sm btn-outline hover:text-primary"
				>
					@common.Icon("simple-icons:youtube", "width", "16", "height", "16")
					watch the playlist
				</a>
			} else {
				<a
					href={ templ.SafeURL(p.ChannelURL) }
					class="btn btn-sm btn-outline hover:text-primary"
				>
					@common.Icon("simple-icons:youtube", "width", "16", "height", "16")
					visit the channel
				</a>
			}
		</header>
		<div class="px-4 py-5 flex flex-col gap-3">
			for _, v := range p.Series.Cards() {
				@VideoCard(v)
			}
			if p.Series.HasPlaylist() && p.Series.Rest() > 0 {
				<p class="text-xs opacity-40">
					{ "+ " + plural(p.Series.Rest(), "more episode") + " in the playlist" }
				</p>
			}
		</div>
	</article>
}

// VideosSection sits under the project grid rather than in a tab of its own,
// so it does not scroll itself -- the panel holding both owns that. The top
// border is what separates it from the grid above, since the two sections
// share a background and would otherwise read as one.
templ VideosSection() {
	<section class="bg-base-200 py-6 px-4 border-t border-base-300">
		<div class="max-w-5xl mx-auto flex flex-col gap-4">
			<h2 class="text-xl font-bold">
				<span class="text-secondary">$ </span>ls ./videos
			</h2>
			@PlaylistTabs()
			for _, p := range PlaylistPanels() {
				@PlaylistContainer(p)
			}
			<p class="opacity-30 text-xs">
				{ plural(len(Channels), "channel") + ", " + plural(TotalVideoCount(), "video") }
			</p>
		</div>
	</section>
}
