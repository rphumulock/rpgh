package components

import (
	"fmt"
	common "rpgh/features/common/components"
)

// DirectoryRow is one entry in the listing. The columns are fixed-width from
// sm up so they line up down the page the way real `ls -l` output does; below
// that they wrap, and the permission column drops, since it is the one column
// that says nothing a visitor needs.
//
// A row grows to share out whatever height the listing has left, which on a
// desktop is most of the page -- four thin strips under a heading left the
// screen mostly empty and the rows looking like an afterthought. The min-height
// is what stops that going the other way on a short window, where flex-1 would
// otherwise squeeze them thinner than their own padding.
templ DirectoryRow(d Dir) {
	<li class="flex lg:flex-1">
		<a
			href={ templ.SafeURL(d.Href()) }
			title={ "Open " + d.Name }
			class="group w-full text-left border border-base-300 px-5 py-5 lg:min-h-24 flex flex-wrap items-center content-center gap-x-5 gap-y-2 hover:border-primary hover:bg-base-100 transition-colors"
		>
			<span class="hidden sm:inline text-xs opacity-30 shrink-0">{ Mode }</span>
			<span class="text-xs opacity-30 shrink-0 sm:w-28">{ d.Size() }</span>
			<span class="text-lg font-bold text-primary flex items-center gap-2.5 shrink-0 sm:w-44">
				@common.Icon(d.Icon, "width", "22", "height", "22")
				<span>{ d.Name }/</span>
			</span>
			<span class="text-sm opacity-60 flex-1 min-w-0">{ d.Blurb }</span>
			<span
				class="text-xs text-primary opacity-0 group-hover:opacity-70 transition-opacity shrink-0"
				aria-hidden="true"
			>
				{ "cd " + d.Name }
			</span>
		</a>
	</li>
}

// DirectorySection is the landing view: the panels of the site rendered as a
// directory listing. A row is a link to the page that directory is served at,
// so cd-ing into one is a navigation the browser knows about -- which is what
// makes the back button the way out of it.
templ DirectorySection() {
	<section class="bg-base-200 py-8 px-4 border-t border-base-300 flex flex-col lg:flex-1 lg:min-h-0 lg:overflow-y-auto">
		<div class="max-w-5xl w-full mx-auto flex flex-col gap-4 lg:flex-1 lg:min-h-0">
			<div class="flex flex-col gap-1">
				<h2 class="text-xl font-bold">
					<span class="text-secondary">$ </span>ls -l ~/rpgh
					@common.Cursor()
				</h2>
				<p class="text-xs opacity-40">
					{ fmt.Sprintf("total %d", len(Dirs())) } &mdash; pick one to cd into.
				</p>
			</div>
			<ul class="flex flex-col gap-3 lg:flex-1">
				for _, d := range Dirs() {
					@DirectoryRow(d)
				}
			</ul>
		</div>
	</section>
}

// PanelPath is the bar at the top of a panel: where you are, and the way back
// out of it. A panel is a directory you cd into, so the way up is the `../`
// you would have typed -- which is also the entry `ls -a` puts at the top of a
// real listing. It is a link to the root, and the browser's own back button is
// the same journey by another name.
templ PanelPath(key string) {
	{{ d := DirByTab(key) }}
	<div class="bg-base-200 border-t border-base-300 shrink-0">
		<div class="max-w-5xl mx-auto px-4 py-2 flex items-baseline gap-3">
			<a
				href={ templ.SafeURL(HomeHref) }
				title={ "Back to " + Root }
				class="flex items-baseline gap-2 text-primary hover:opacity-60 transition-opacity"
			>
				<span class="opacity-40 select-none" aria-hidden="true">&#8593;</span>
				<span class="border-b border-dotted border-primary">../</span>
			</a>
			<span class="text-xs opacity-30 truncate">{ d.Path() }</span>
		</div>
	</div>
}
