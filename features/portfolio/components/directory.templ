package components

import (
	"fmt"
	common "rpgh/features/common/components"
)

// DirectoryRow is one entry in the listing. The columns are fixed-width from
// sm up so they line up down the page the way real `ls -l` output does; below
// that they wrap, and the permission column drops, since it is the one column
// that says nothing a visitor needs.
templ DirectoryRow(d Dir) {
	<li>
		<button
			type="button"
			title={ "Open " + d.Name }
			class="group w-full text-left border border-base-300 px-4 py-3 flex flex-wrap items-baseline gap-x-4 gap-y-1 hover:border-primary transition-colors"
			data-on:click={ SetTabExpr(d.Key) }
		>
			<span class="hidden sm:inline text-xs opacity-30 shrink-0">{ Mode }</span>
			<span class="text-xs opacity-30 shrink-0 sm:w-24">{ d.Size() }</span>
			<span class="font-bold text-primary flex items-center gap-2 shrink-0 sm:w-40">
				@common.Icon(d.Icon, "width", "18", "height", "18")
				<span>{ d.Name }/</span>
			</span>
			<span class="text-sm opacity-60 flex-1 min-w-0">{ d.Blurb }</span>
			<span
				class="text-xs text-primary opacity-0 group-hover:opacity-70 transition-opacity shrink-0"
				aria-hidden="true"
			>
				{ "cd " + d.Name }
			</span>
		</button>
	</li>
}

// DirectorySection is the landing view: the three panels of the site rendered
// as a directory listing. A row sets the same $tab signal the tab bar sets, so
// clicking one is clicking its tab -- the panel it opens behaves exactly as it
// did when it was the thing you landed on.
templ DirectorySection() {
	<section class="bg-base-200 py-8 px-4 border-t border-base-300 lg:flex-1 lg:min-h-0 lg:overflow-y-auto">
		<div class="max-w-5xl mx-auto flex flex-col gap-4">
			<div class="flex flex-col gap-1">
				<h2 class="text-xl font-bold">
					<span class="text-secondary">$ </span>ls -l ~/rpgh
					@common.Cursor()
				</h2>
				<p class="text-xs opacity-40">
					{ fmt.Sprintf("total %d", len(Dirs())) } &mdash; pick one to cd into.
				</p>
			</div>
			<ul class="flex flex-col gap-2">
				for _, d := range Dirs() {
					@DirectoryRow(d)
				}
			</ul>
		</div>
	</section>
}

// PanelPath is the bar at the top of a panel: where you are, and the one way
// back out of it. A panel is a directory you cd into, so the way up is the
// `../` you would have typed -- which is also the entry `ls -a` puts at the
// top of a real listing.
templ PanelPath(key string) {
	{{ d := DirByTab(key) }}
	<div class="bg-base-200 border-t border-base-300 shrink-0">
		<div class="max-w-5xl mx-auto px-4 py-2 flex items-baseline gap-3">
			<button
				type="button"
				title={ "Back to " + Root }
				class="flex items-baseline gap-2 text-primary hover:opacity-60 transition-opacity"
				data-on:click={ SetTabExpr(TabHome) }
			>
				<span class="opacity-40 select-none" aria-hidden="true">&#8593;</span>
				<span class="border-b border-dotted border-primary">../</span>
			</button>
			<span class="text-xs opacity-30 truncate">{ d.Path() }</span>
		</div>
	</div>
}
