package components

import (
	"fmt"

	"rpgh/features/blog/content"
	common "rpgh/features/common/components"
)

// PostRow is one post on the listing: when, what, and a line on why. The whole
// row is the link, since a row with nothing else on it has no second target to
// compete with.
templ PostRow(p content.Post) {
	<li>
		<a
			href={ templ.SafeURL(p.Href()) }
			class="group border border-base-300 px-4 py-3 flex flex-col sm:flex-row sm:items-baseline gap-x-4 gap-y-1 hover:border-primary transition-colors"
		>
			<span class="text-xs opacity-30 shrink-0 sm:w-24">{ p.Date() }</span>
			<span class="flex flex-col gap-1 min-w-0">
				<span class="font-bold">
					<span class="text-secondary">$ </span>{ p.Title }
				</span>
				<span class="text-sm opacity-60">{ p.Blurb }</span>
			</span>
			<span
				class="text-xs text-primary opacity-0 group-hover:opacity-70 transition-opacity shrink-0 sm:ml-auto"
				aria-hidden="true"
			>
				{ "cat " + p.Slug + ".md" }
			</span>
		</a>
	</li>
}

// EmptyShelf is what the section is today. An empty directory is a real thing
// for `ls` to print, so it says so in the same voice rather than hiding the
// section until there is something in it -- the front page counts it either
// way, and a row that opened onto nothing at all would read as broken.
templ EmptyShelf() {
	<div class="border border-dashed border-base-300 px-4 py-8 flex flex-col items-center gap-3 text-center">
		<span class="text-primary opacity-40">
			@common.Icon("lucide:file-pen-line", "width", "32", "height", "32")
		</span>
		<p class="opacity-50">Nothing written yet.</p>
		<p class="text-sm opacity-30 max-w-md">
			Notes on what I am building land here first &mdash; the reasons behind the
			choices in { "./projects" }, written down while they are still fresh.
		</p>
	</div>
}

// BlogsSection is the blogs panel. Posts are Markdown files in the repository,
// so the count here and the pages behind it move together on one commit.
templ BlogsSection() {
	<section class="bg-base-100 py-6 px-4 lg:flex-1 lg:min-h-0 lg:overflow-y-auto">
		<div class="max-w-5xl mx-auto flex flex-col gap-4">
			<div class="flex flex-col gap-1">
				<h2 class="text-xl font-bold">
					<span class="text-secondary">$ </span>ls ./blogs
				</h2>
				<p class="text-xs opacity-40">{ fmt.Sprintf("total %d", len(content.Posts())) }</p>
			</div>
			if posts := content.Posts(); len(posts) > 0 {
				<ul class="flex flex-col gap-2">
					for _, p := range posts {
						@PostRow(p)
					}
				</ul>
			} else {
				@EmptyShelf()
			}
		</div>
	</section>
}
