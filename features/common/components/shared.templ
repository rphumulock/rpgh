package components

func KVPairsAttrs(kvPairs ...string) templ.Attributes {
	if len(kvPairs)%2 != 0 {
		panic("kvPairs must be a multiple of 2")
	}
	attrs := templ.Attributes{}
	for i := 0; i < len(kvPairs); i += 2 {
		attrs[kvPairs[i]] = kvPairs[i+1]
	}
	return attrs
}

templ Icon(icon string, attrs ...string) {
	<iconify-icon icon={ icon } { KVPairsAttrs(attrs...)... } noobserver></iconify-icon>
}

// Cursor is the blinking block caret that trails a prompt heading. Its
// animation lives in styles.css under [data-theme="terminal"].
templ Cursor() {
	<span class="terminal-cursor" aria-hidden="true">&#9608;</span>
}
