package components

import (
	"rpgh/features/host"
)

// Strip is the line in the footer showing what this site is running on. The
// hardware is stated; the numbers beside it are the container's own, read from
// a namespaced /proc and labelled as such rather than passed off as the box's.
templ Strip() {
	<div
		class="flex flex-col gap-0.5 text-xs"
		data-signals={ templ.JSONString(host.Pending()) }
		data-init="@get('/host/events', {retryMaxCount: Infinity, retryInterval: 1000, retryMaxWaitMs: 30000})"
	>
		<p>
			<span class="text-secondary">$ </span>uptime
		</p>
		<p class="opacity-60">
			{ host.Chassis } · { host.Hardware() } &mdash; at home, under my roof
		</p>
		<p class="opacity-40 flex flex-wrap gap-x-3">
			<span>up <span class="text-primary" data-text="$hostUptime"></span></span>
			<span>load <span class="text-primary" data-text="$hostLoad"></span></span>
			<span>mem <span class="text-primary" data-text="$hostMem"></span></span>
			<span>cpu <span class="text-primary" data-text="$hostCpu"></span></span>
			<span class="opacity-60">(this container, not the whole box)</span>
		</p>
	</div>
}
